# Local MongoDB (the one Compass connects to). For Atlas, paste your mongodb+srv:// string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/plugnpark
SESSION_SECRET=change-this-to-a-long-random-string
# Comma-separated emails that get the admin panel at /admin
ADMIN_EMAILS=

# Open Charge Map (free key from openchargemap.org -> My Profile -> My Apps)
OCM_API_KEY=

# Optional: free CARTO map key (carto.com/basemaps/apikey) for the native dark map style. Leave empty to use OpenStreetMap.
NEXT_PUBLIC_CARTO_KEY=

# Optional: your email, sent to OpenStreetMap place search as the app contact (their usage policy asks apps to identify themselves)
GEOCODE_CONTACT=

# Optional: your own OSRM routing server (default is the public demo server, fine for demos)
OSRM_URL=

# Time zone used by the forecast chart (default Asia/Kolkata)
APP_TIMEZONE=
